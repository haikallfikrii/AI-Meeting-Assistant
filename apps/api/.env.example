# API
PORT=8787
APP_URL=https://kalfi.app
API_PUBLIC_URL=https://api.srv835792.hstgr.cloud
JWT_SECRET=change-me-to-a-long-random-string
# Optional: master dashboard at /admin — header X-Admin-Secret
ADMIN_SECRET=

# Lemon Squeezy (legacy — being replaced by Polar)
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=475862
LEMONSQUEEZY_WEBHOOK_SECRET=
# Variant IDs (defaults are baked into code; override if you recreate products)
LEMONSQUEEZY_VARIANT_BYOK_MONTHLY=2137642
LEMONSQUEEZY_VARIANT_BYOK_ANNUAL=2137823
LEMONSQUEEZY_VARIANT_HOSTED_MONTHLY=2137653
LEMONSQUEEZY_VARIANT_HOSTED_ANNUAL=2137832
LEMONSQUEEZY_VARIANT_TEAM=2137656
LEMONSQUEEZY_VARIANT_SINGLE_SESSION=2137842

# Polar.sh (Merchant of Record — primary billing)
# Create an Organization Access Token in Polar dashboard (server-side only).
# Sandbox tokens only work with POLAR_ENVIRONMENT=sandbox (and vice versa).
POLAR_ACCESS_TOKEN=
POLAR_ENVIRONMENT=sandbox
# Webhook signing secret from Polar → Settings → Webhooks
POLAR_WEBHOOK_SECRET=
# Optional org id (license key validate helper)
# POLAR_ORGANIZATION_ID=
# Product IDs — defaults baked in polar-products.ts; override only if you recreate products
POLAR_PRODUCT_BYOK_MONTHLY=b3362eda-3a8e-4983-9a67-946da235877b
POLAR_PRODUCT_BYOK_ANNUAL=f3d03286-b7b5-49aa-a6dc-6e78e11b265d
POLAR_PRODUCT_HOSTED_MONTHLY=1ed73894-702d-4772-bbe1-f41ac920b360
POLAR_PRODUCT_HOSTED_ANNUAL=3f4f6bfd-45c4-4131-aaf8-f7b609d457d0
POLAR_PRODUCT_TEAM=1ffa4fd9-ace4-4528-9b78-8000fde38678
POLAR_PRODUCT_SINGLE_SESSION=d9007072-d979-4053-bbf2-1d37efddb6e9
# Optional: allow embed checkout from these origins (also whitelist in Polar → Embedding)
# POLAR_EMBED_ORIGIN=https://kalfi.app

# Polar webhook URL to register in dashboard:
#   https://api.srv835792.hstgr.cloud/v1/billing/webhook/polar
# Events: subscription.created, subscription.active, subscription.updated,
#   subscription.canceled, subscription.revoked, subscription.past_due,
#   order.created, order.paid, benefit_grant.created

# Wise / manual USD payments (default while MoR card payments blocked)
WISE_ENABLED=1
WISE_EMAIL=hello@kalfi.app
WISE_ACCOUNT_NAME=Kalfi
# Optional Wise payment link from your Wise Business account
WISE_PAY_LINK=
WISE_NOTIFY_EMAIL=hello@kalfi.app
# Hosted AI
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
HOSTED_CHAT_MODEL=openai/gpt-4o-mini
HOSTED_STT_MODEL=openai/whisper-1
PRO_MONTHLY_TOKEN_SOFT_CAP=2000000
CORS_ORIGINS=https://kalfi.app,https://www.kalfi.app,https://ai.chatlm.tech,http://localhost:5173,http://127.0.0.1:5500

# Email OTP — prefer Hostinger SMTP (hello@kalfi.app), optional Resend fallback
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=1
SMTP_USER=hello@kalfi.app
SMTP_PASS=
EMAIL_FROM=Kalfi <hello@kalfi.app>
RESEND_API_KEY=
# If neither SMTP nor Resend is set, OTP codes are returned inline (test mode only)
AUTH_DEV_CODES=
